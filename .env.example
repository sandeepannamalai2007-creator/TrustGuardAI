# TrustGuard AI — Environment Configuration Example Template
# Copy this file to .env and populate with production secrets. Never commit .env to Git.

# Application Environment
TRUSTGUARD_ENV=production

# Security Credentials (Must be strong, non-default in production)
TRUSTGUARD_JWT_SECRET=super-secret-trustguard-jwt-key-min-32-chars-prod
TRUSTGUARD_ADMIN_PIN=admin_secure_pin_123456
TRUSTGUARD_STEP_UP_PIN=stepup_secure_pin_999999

# PostgreSQL Database Configuration
POSTGRES_DB=trustguard_db
POSTGRES_USER=trustguard_user
POSTGRES_PASSWORD=trustguard_secure_db_pass
DATABASE_URL=postgresql://trustguard_user:trustguard_secure_db_pass@db:5432/trustguard_db

# Redis Configuration & Authentication
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=redis_secure_pass
REDIS_SSL=false
REDIS_DB=0
REDIS_TIMEOUT=2.0

# CORS & Network Hardening
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost
ENABLE_HTTPS_REDIRECT=false
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12,10.0.0.0/8
