# TrustGuard AI — Environment Configuration Example Template
# Copy this file to .env and populate with real production secrets. Never commit .env to Git.

# Application Environment (development / production)
TRUSTGUARD_ENV=production

# Security Credentials (Must be at least 32 chars for JWT, 6+ digits for PINs)
TRUSTGUARD_JWT_SECRET=your_32_character_minimum_random_production_jwt_secret
TRUSTGUARD_ADMIN_PIN=your_6_digit_admin_pin
TRUSTGUARD_STEP_UP_PIN=your_6_digit_stepup_pin

# PostgreSQL Database Configuration
POSTGRES_DB=trustguard_db
POSTGRES_USER=trustguard_user
POSTGRES_PASSWORD=your_strong_postgres_password

# Redis Configuration & Authentication
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=your_strong_redis_password
REDIS_SSL=false
REDIS_DB=0
REDIS_TIMEOUT=2.0

# CORS & Network Hardening
ALLOWED_ORIGINS=https://trustguard.yourdomain.com
ENABLE_HTTPS_REDIRECT=true
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12,10.0.0.0/8
